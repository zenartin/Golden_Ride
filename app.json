{
  "expo": {
    "name": "Golden Ride",
    "slug": "golden-ride-user",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.goldenride.user",
      "buildNumber": "6"
    },
    "android": {
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDbdW16zZqPVpdurydxr3VOXwHn3j85Dz4"
        }
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.goldenride.user",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "versionCode": 6
    },
    "web": {
      "favicon": "./favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Golden Ride to access your location while you use the app."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Golden Ride to access your camera for dashcam recording.",
          "microphonePermission": "Allow Golden Ride to access your microphone for dashcam audio."
        }
      ],
      "expo-font",
      "@react-native-community/datetimepicker",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 34,
            "targetSdkVersion": 34,
            "minSdkVersion": 24
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ]
    ],
    "runtimeVersion": "1.0.0",
    "extra": {
      "eas": {
        "projectId": "e5a0c852-3e63-44a5-9f0a-82d1a9c50e4a"
      }
    },
    "owner": "zenartin03"
  }
}
