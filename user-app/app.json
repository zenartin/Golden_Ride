{
  "expo": {
    "name": "Golden Ride",
    "slug": "golden-ride-user",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.goldenride.user"
    },
    "android": {
      "package": "com.goldenride.user",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Golden Ride to access your location while you use the app."
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "adb3c67a-33b9-4280-994f-77100c053c4d"
      }
    },
    "owner": "zenartin"
  }
}
