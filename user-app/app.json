{
  "expo": {
    "name": "Golden Ride",
    "slug": "golden-ride-user",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.goldenride.user"
    },
    "android": {
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDbdW16zZqPVpdurydxr3VOXwHn3j85Dz4"
        }
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.goldenride.user",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Golden Ride to access your location while you use the app."
        }
      ],
      "expo-font"
    ],
    "owner": "zenartin03",
    "extra": {
      "eas": {
        "projectId": "e5a0c852-3e63-44a5-9f0a-82d1a9c50e4a"
      }
    }
  }
}
